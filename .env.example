# Copy to .env.local (git-ignored) and adjust. Placeholders only: never commit real values.
# Read by both apps: the web app via next.config.ts, the MCP server via `node --env-file-if-exists`.

# --- Mode switches (mock works with no external credentials) ---
NODE_ENV=development
DATA_MODE=mock                 # mock | live (live arrives in the final phase)
AUTH_MODE=mock                 # web: mock | supabase (supabase = real sign-up/login)
DB_MODE=mock                   # mock | postgres (postgres needs SUPABASE_DB_URL; see docs/SUPABASE-SETUP.md)
MCP_AUTH_MODE=mock             # mcp: mock | oauth  (mock accepts "Bearer mock:<userId>")
ALLOW_MOCK_IN_PRODUCTION=false # only for local smoke tests of production builds
LOG_LEVEL=info

# --- Public app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MCP server ---
# On Hostinger these are entered in hPanel -> Environment variables, not in a file (docs/HOSTINGER-DEPLOY.md).
PORT=8787
MCP_PUBLIC_URL=http://localhost:8787
# Needed when MCP_AUTH_MODE=oauth (see docs/MCP.md):
# MCP_OAUTH_ISSUER_URL=https://<project-ref>.supabase.co/auth/v1
# MCP_JWKS_URL=                          # default: <issuer>/.well-known/jwks.json
# MCP_RESOURCE_AUDIENCE=http://localhost:8787/mcp   # default: the MCP URL; must be set by an access-token hook
# MCP_ACCEPT_DEFAULT_SUPABASE_AUDIENCE=false        # true only to knowingly accept aud="authenticated"
# MCP_REQUIRED_SCOPES=
# MCP_ALLOWED_ORIGINS=                   # comma-separated browser origins allowed to call /mcp
# NEXT_PUBLIC_MCP_URL=http://localhost:8787/mcp     # web app: shown on the dashboard

# --- Supabase (set when AUTH_MODE=supabase / DB_MODE=postgres) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable (anon) key only. Safe for browsers.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-key
# Server-only: never prefix with NEXT_PUBLIC_
# Postgres connection string (use the pooler URL from Project Settings -> Database)
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth: ONE client owned by the operator (you), shared by all customers. See docs/GOOGLE-SETUP.md ---
# Server-only. The secret is never sent to the browser. Both apps (web AND mcp-server) need the id and secret,
# and both must use the same SECRET_KEYS. Leave blank while DATA_MODE=mock.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to ${NEXT_PUBLIC_APP_URL}/api/oauth/google/callback. Must equal a redirect URI registered in Google exactly.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
# Shown on /privacy (required by Google before the app can be verified).
# SUPPORT_EMAIL=

# --- Bing Webmaster Tools ---
# OPTIONAL: only for the "Connect with Bing" login. Create the client in Bing Webmaster Tools > Settings > API Access >
# OAuth Client (docs/BING.md). Without these, customers can still connect with their own Bing API key.
# Redirect URI to register: <your app URL>/api/oauth/bing/callback. The secret is server-side only. Never commit it.
BING_CLIENT_ID=
BING_CLIENT_SECRET=
BING_REDIRECT_URI=http://localhost:3000/api/oauth/bing/callback

# --- Secret encryption (provider tokens are envelope-encrypted; see docs/SECRETS.md) ---
# Comma-separated "<version>:<base64 32-byte key>" entries. Leave empty in development: a throwaway
# in-memory key is used and stored credentials do not survive a restart. REQUIRED in production.
# Generate one: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEYS=
# Which version encrypts new data (defaults to the last entry). Set when rotating.
SECRET_CURRENT_KEY_VERSION=

# --- Microsoft Clarity (customers paste their own project API token in the dashboard; no Google Cloud setup) ---
# Key for the one-way fingerprint of each Clarity token (quota grouping, duplicate detection). REQUIRED in production
# (saving a token is refused without it). Keep it separate from SECRET_KEYS and back it up: if it changes, quota history
# restarts. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Needed by BOTH the web app and the mcp-server (same value).
CREDENTIAL_FINGERPRINT_KEY=
# This app's own per-project daily request budget (Clarity allows 10/day; 8 leaves room for the owner's own use).
# 1000 = no app-side limit (Clarity still enforces its own 10/day). Set 8 to keep spare requests.
CLARITY_LOCAL_DAILY_BUDGET=1000
# Only for the manual live test (pnpm clarity:check --yes). Put a token here ONLY while testing, then delete it. Never commit.
# CLARITY_TEST_TOKEN=
# Only for the manual live test (pnpm bing:check --yes). Put a key here ONLY while testing, then delete it. Never commit.
# BING_TEST_API_KEY=

# --- Feature flags ---
PROVIDER_GSC_ENABLED=true
PROVIDER_GA4_ENABLED=true
PROVIDER_CLARITY_ENABLED=true
# Keep false until `pnpm bing:check --yes` passes against your own Bing account (docs/BING.md).
PROVIDER_BING_ENABLED=false

# --- Request behavior ---
REPORT_CACHE_DEFAULT_TTL_SECONDS=900
# One overall deadline per report (all attempts included), and the HTTP timeout of a single attempt.
PROVIDER_REQUEST_TIMEOUT_MS=20000
# Extra attempts after a transient provider failure (0-5). Quota, auth and validation errors are never retried.
REPORT_MAX_RETRIES=2
# Token buckets charged only for real upstream calls; cache hits are free. Per process.
REPORT_RATE_LIMIT_PER_USER_PER_MINUTE=60
REPORT_RATE_LIMIT_PER_CONNECTION_PER_MINUTE=30
# How old a saved report may be when it is served because the provider is failing.
REPORT_MAX_STALE_SECONDS=86400
MAX_MCP_CONCURRENT_REPORTS_PER_USER=3
MAX_REPORT_ROWS_DEFAULT=25
MAX_REPORT_ROWS_HARD_LIMIT=1000
