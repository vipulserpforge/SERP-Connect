# Template for the MCP server settings on the VPS. Real file: ~/mcp.env (permissions 600). NEVER commit a real one.
# The easiest way to get the real values is the mcp.env you already made in ~/Documents/private-serp/ (see docs/mcp-web.md).
# One NAME=value per line, no quotes, no spaces around "=". Do NOT add NODE_ENV or PORT (PM2 sets them).
DB_MODE=postgres
DATA_MODE=live
SUPABASE_DB_URL=<Supabase pooler database URL, includes the password>
SECRET_KEYS=<the SAME value as on Vercel>
CREDENTIAL_FINGERPRINT_KEY=<the SAME value as on Vercel>
GOOGLE_CLIENT_ID=<same as on Vercel>
GOOGLE_CLIENT_SECRET=<same as on Vercel>
MCP_PUBLIC_URL=https://mcp.visibll.in
MCP_AUTH_MODE=oauth
MCP_OAUTH_ISSUER_URL=https://<your-project-ref>.supabase.co/auth/v1
MCP_RESOURCE_AUDIENCE=https://mcp.visibll.in/mcp
